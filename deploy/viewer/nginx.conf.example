# Illustrative server block; provision TLS and validate with nginx -t separately.
# Use a dedicated virtual host. Replace origin and certificate paths together.
server {
    listen 443 ssl;
    server_name review.example.com;
    ssl_certificate /etc/ssl/dstar/fullchain.pem;
    ssl_certificate_key /etc/ssl/dstar/privkey.pem;

    # Do not rewrite an unexpected client Host into the trusted authority.
    if ($http_host != "review.example.com") { return 403; }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # Drop all original headers, including arbitrary X-Forwarded-* names,
        # then forward only the fields the Viewer needs. Never synthesize Origin.
        proxy_pass_request_headers off;
        proxy_set_header Host review.example.com;
        proxy_set_header Origin $http_origin;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Connection "";
        # Frame URLs are read capabilities. Do not log them or request headers.
        access_log off;
        error_log /dev/null crit;
        proxy_cache off;
        proxy_read_timeout 30s;
    }
}
