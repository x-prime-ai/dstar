# Copy outside version control; no credential is supplied in this example.
# This is for the Node entrypoint. Compose fixes its container root/host/port
# and uses DSTAR_VIEWER_TOKEN_FILE as the HOST path to its mounted secret.
DSTAR_PACKAGE_ROOT=/srv/dstar/document.dstar
DSTAR_BIND_HOST=127.0.0.1
DSTAR_PORT=3000
DSTAR_EXTERNAL_ORIGIN=https://review.example.com
DSTAR_VIEWER_TOKEN_FILE=/srv/dstar-secrets/viewer-token
# Alternative: inject DSTAR_VIEWER_TOKEN from the service's secret manager.
# Never set both token sources. Generate a unique random secret per instance.
