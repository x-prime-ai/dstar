# Copy outside version control; no credential is supplied in this example.
# This is for the Node entrypoint. Compose fixes its container root/host/port
# and uses the two *_TOKEN_FILE values as HOST paths to mounted secrets.
DSTAR_PACKAGE_ROOT=/srv/dstar/document.dstar
DSTAR_BIND_HOST=127.0.0.1
DSTAR_PORT=3000
DSTAR_EXTERNAL_ORIGIN=https://review.example.com
DSTAR_OWNER_TOKEN_FILE=/srv/dstar-secrets/owner-token
DSTAR_REVIEWER_TOKEN_FILE=/srv/dstar-secrets/reviewer-token
DSTAR_OWNER_DISPLAY_NAME=Document Owner
DSTAR_REVIEWER_DISPLAY_NAME=Review Partner
# Alternative: inject DSTAR_OWNER_TOKEN and DSTAR_REVIEWER_TOKEN from a secret
# manager. Never set both sources for one role. Tokens must be independent.
