{
  "format": "dstar-mcp-resources/0.1",
  "templates": [
    "dstar://document/manifest",
    "dstar://document/node/{nodeId}",
    "dstar://annotation/{annotationId}",
    "dstar://source/{sourceId}",
    "dstar://projection/{projectionId}/mapping",
    "dstar://genesis/request"
  ],
  "minimalDocumentPrincipal": "human_demo",
  "resources": [
    "dstar://document/manifest",
    "dstar://document/node/node_root",
    "dstar://document/node/node_title",
    "dstar://document/node/node_promise",
    "dstar://document/node/node_resources",
    "dstar://document/node/node_architecture",
    "dstar://annotation/ann_0001",
    "dstar://source/source_dstar_spec",
    "dstar://projection/projection_markdown/mapping",
    "dstar://projection/projection_summary/mapping",
    "dstar://projection/projection_excerpt/mapping",
    "dstar://projection/projection_html/mapping"
  ],
  "forbidden": ["dstar://annotation/human-only", "file:///etc/passwd"],
  "fallback": "tools"
}
