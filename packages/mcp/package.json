{
  "name": "@dstar/mcp",
  "version": "0.1.0",
  "description": "MCP server adapter for the DSTAR Core API",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false"
  },
  "dependencies": {
    "@dstar/core": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
