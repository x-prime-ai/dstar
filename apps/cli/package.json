{
  "name": "@dstar/cli",
  "version": "0.0.0",
  "description": "DSTAR command-line interface",
  "type": "module",
  "private": true,
  "bin": {
    "dstar": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false"
  },
  "dependencies": {
    "@dstar/core": "workspace:*",
    "@dstar/node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
