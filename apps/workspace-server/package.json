{
  "name": "@dstar/workspace-server",
  "version": "0.0.0",
  "description": "Loopback-only DSTAR review API",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false"
  },
  "dependencies": {
    "@dstar/core": "workspace:*",
    "@dstar/node": "workspace:*",
    "@dstar/render-html": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
