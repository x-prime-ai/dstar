{
  "format": "dstar-security-corpus/0.1",
  "ijson": [
    {
      "id": "duplicate-key",
      "input": "{\"same\":1,\"same\":2}",
      "error": "JSON_DUPLICATE_KEY"
    },
    {
      "id": "unpaired-surrogate",
      "input": "\"\\ud800\"",
      "error": "JSON_INVALID_UNICODE"
    },
    {
      "id": "unsafe-integer",
      "input": "9007199254740992",
      "error": "JSON_INVALID_NUMBER"
    },
    {
      "id": "depth-limit",
      "input": "[[[]]]",
      "limits": { "maxDepth": 2 },
      "error": "JSON_DEPTH_EXCEEDED"
    },
    {
      "id": "array-limit",
      "input": "[1,2]",
      "limits": { "maxArrayLength": 1 },
      "error": "JSON_LIMIT_EXCEEDED"
    }
  ],
  "paths": [
    { "input": "../secret", "valid": false, "code": "dot-segment" },
    { "input": "/absolute", "valid": false, "code": "absolute" },
    { "input": "assets\\escape", "valid": false, "code": "backslash" },
    { "input": "safe/asset.png", "valid": true }
  ],
  "links": [
    { "input": "javascript:alert(1)", "safe": null },
    { "input": "data:text/html,<script>1</script>", "safe": null },
    {
      "input": "https://example.test/path",
      "safe": "https://example.test/path"
    },
    { "input": "assets/image.png", "safe": "assets/image.png" }
  ],
  "generatedHtml": [
    { "input": "<script>alert(1)</script>", "safe": false },
    { "input": "<img src=x onerror=alert(1)>", "safe": false },
    { "input": "<p>visible text</p>", "safe": true }
  ]
}
